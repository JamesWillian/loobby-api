# /etc/loobby/api.env -- dono root:loobby, modo 0640. Contem segredos.
#
# DB_URL no formato do pgx, com usuario e senha escapados dentro da URL. O pooler
# do Supabase em modo transacao (6543) pede default_query_exec_mode=simple_protocol
# (deploy/go/README.md). DB_USERNAME e DB_PASSWORD so valem com URL JDBC.
#
# O JWT_SECRET precisa ser o de producao: com outro, os tokens ja emitidos
# deixam de valer e os apps levam 401.
DB_URL=
JWT_SECRET=
RAWG_API_KEY=
RESEND_API_KEY=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Base dos links enviados por email (verificacao e reset de senha).
APP_BASE_URL=https://api.loobby.app

# Uploads (avatares, imagens de grupo). A pasta e criada pelo systemd
# (StateDirectory).
FILE_STORAGE_LOCATION=/var/lib/loobby/uploads

# Push. Com NOTIFICATIONS_ENABLED=true (o padrao), o arquivo de credenciais do
# Firebase PRECISA existir, senao o servico nao sobe.
NOTIFICATIONS_ENABLED=true
FIREBASE_CREDENTIALS_PATH=/etc/loobby/loobby-fcm.json
# Jobs agendados (lembretes e avisos diarios).
NOTIFICATIONS_SCHEDULER_ENABLED=true

# Comportamentos em que o Go pode ser mais estrito que o Kotlin era. Os valores
# abaixo sao os padroes; ver contract/ACHADOS.md §22 antes de mexer.
#ACCEPT_REFRESH_AS_ACCESS=true
#ALLOW_UNSIGNED_ANON_REFRESH=false

# HTTP puro, so no loopback: o TLS publico termina no nginx da mesma maquina.
# (TLS_CERT_FILE, TLS_KEY_FILE e TLS_CLIENT_CA_FILE ligam o TLS mutuo do desenho
# anterior; em producao ficam de fora.)
PORT=8080

# O coletor de lixo do Go passa a trabalhar mais antes de chegar neste valor.
# Abaixo do MemoryMax do systemd (256M), numa maquina de 1 GB.
GOMEMLIMIT=192MiB
