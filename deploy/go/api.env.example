# /etc/loobby/api.env -- dono root:loobby, modo 0640. Contem segredos.
#
# Sao AS MESMAS variaveis do Kotlin, com os mesmos valores. Em especial o
# JWT_SECRET: com outro segredo, nenhum token emitido pelo Kotlin vale no Go, e
# todo usuario numa rota migrada leva 401.
DB_URL=
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
RAWG_API_KEY=
RESEND_API_KEY=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Base dos links enviados por email (verificacao e reset de senha).
APP_BASE_URL=https://api.loobby.app

# Uploads (avatares, imagens de grupo). A pasta e criada pelo systemd
# (StateDirectory). No cutover de `files`, copie para ca os uploads do Kotlin.
FILE_STORAGE_LOCATION=/var/lib/loobby/uploads

# Push. Com NOTIFICATIONS_ENABLED=true (o padrao), o arquivo de credenciais do
# Firebase PRECISA existir, senao o servico nao sobe -- igual ao Kotlin.
NOTIFICATIONS_ENABLED=true
FIREBASE_CREDENTIALS_PATH=/etc/loobby/loobby-fcm.json
# Jobs agendados (lembretes, pagamento pendente). Deixe false enquanto o Kotlin
# estiver no ar rodando os dele; passe para true no dia em que o Kotlin sair.
NOTIFICATIONS_SCHEDULER_ENABLED=false

# Comportamentos em que o Go pode ser mais estrito que o Kotlin. Os valores
# abaixo sao os padroes; ver contract/ACHADOS.md §22 antes de mexer.
#ACCEPT_REFRESH_AS_ACCESS=true
#ALLOW_UNSIGNED_ANON_REFRESH=false

# TLS mutuo com o nginx do AWS (arquivos de deploy/certs/gen-certs.sh)
PORT=8443
TLS_CERT_FILE=/etc/loobby/tls/go-server.crt
TLS_KEY_FILE=/etc/loobby/tls/go-server.key
TLS_CLIENT_CA_FILE=/etc/loobby/tls/ca.crt

# O coletor de lixo do Go passa a trabalhar mais antes de chegar neste valor.
# Abaixo do MemoryMax do systemd (256M), numa maquina de 1 GB.
GOMEMLIMIT=192MiB
