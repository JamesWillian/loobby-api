# /etc/loobby/api.env -- dono root:loobby, modo 0640. Contem segredos.
#
# Banco e JWT: OS MESMOS valores do Kotlin. Com outro JWT_SECRET, nenhum token
# emitido pelo Kotlin vale no Go, e todo usuario numa rota migrada leva 401.
DB_URL=
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
RAWG_API_KEY=

# TLS mutuo com o nginx do AWS (arquivos de deploy/certs/gen-certs.sh)
PORT=8443
TLS_CERT_FILE=/etc/loobby/tls/go-server.crt
TLS_KEY_FILE=/etc/loobby/tls/go-server.key
TLS_CLIENT_CA_FILE=/etc/loobby/tls/ca.crt

# O coletor de lixo do Go passa a trabalhar mais antes de chegar neste valor.
# Abaixo do MemoryMax do systemd (256M), numa maquina de 1 GB.
GOMEMLIMIT=192MiB
